<?xml version="1.0" encoding="utf-8"?>
<!--
  File cấu hình NuGet dành riêng cho môi trường Docker (Linux container)
  Mục đích: Xóa bỏ tham chiếu đến thư mục fallback của Visual Studio trên Windows
  Vì Docker chạy trên Linux, không có đường dẫn C:\Program Files\...
-->
<configuration>
  <fallbackPackageFolders>
    <!-- Xóa toàn bộ fallback folder mặc định của Windows/Visual Studio -->
    <clear />
  </fallbackPackageFolders>
</configuration>
